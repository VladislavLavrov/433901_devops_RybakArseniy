@using Calculator16.Models
@using Calculator16.Extension
@model IEnumerable<Calculator16.Models.DataInputVariant>

@{
    ViewData["Title"] = "Калькулятор";
}

<h2>Калькулятор</h2>

<form method="post" asp-controller="Calculator"
      asp-action="Calculate">

    @Html.AntiForgeryToken()

    <div style="margin: 15px 0;">
        <input type="text" name="num1"
               placeholder="Число 1" required />

        <select name="operation" required>
            <option value="Add">Сложение (+)</option>
            <option value="Subtract">Вычитание (-)</option>
            <option value="Multiply">Умножение (*)</option>
            <option value="Divide">Деление (/)</option>
        </select>

        <input type="text" name="num2"
               placeholder="Число 2" required />
    </div>

    <input type="submit" value="Рассчитать"
           class="btn btn-primary" />
</form>

@if (TempData["Error"] != null)
{
    <p class="text-danger">@TempData["Error"]</p>
}

<hr />

<h3>История вычислений</h3>

<a asp-action="Index" class="btn btn-secondary">
    Обновить результаты
</a>

<table class="table table-bordered table-striped mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Число 1</th>
            <th>Операция</th>
            <th>Число 2</th>
            <th>Результат</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID_DataInputVariant</td>
                <td>@item.Operand_1</td>
                <td>@item.Type_operation.GetDisplayName()</td>
                <td>@item.Operand_2</td>
                <td>@item.Result</td>
            </tr>
        }
    </tbody>
</table>

<footer style="margin-top: 40px; color: gray;">
    <p>Студент: <b>Рыбак Арсений</b> |
       Группа: <b>433901</b> |
       Вариант: <b>16</b></p>
</footer>
